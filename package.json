{
  "name": "mocklens",
  "version": "0.1.0",
  "description": "CLI tool for building, viewing, screenshotting, and validating static mobile UI mockups in plain HTML/CSS",
  "type": "module",
  "bin": {
    "mocklens": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "mocklens": "npm run build && node dist/cli.js"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
